# ==============================================================================
# Telegram Multimodal Studio Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# NormaHub AI Gateway Credentials
# Obtain your key at https://normahub.cc (CIS/Russia direct access, no VPN needed)
NORMAHUB_API_KEY=nr_hub_your_actual_normahub_api_key_here
NORMAHUB_BASE_URL=https://api.normahub.cc/v1

# SQLite WAL Task Storage Path
# Persists ongoing and completed generation tasks across bot restarts
DB_PATH=data/tasks.db

# Default Models
# Video generation: "seedance-2.5", "seedance-2.0", "grok-imagine-video-1.5"
DEFAULT_VIDEO_MODEL=seedance-2.5
# Audio / voice transcription: "whisper-1"
DEFAULT_WHISPER_MODEL=whisper-1

# Queue Worker Settings
MAX_CONCURRENT_TASKS=5
POLL_INTERVAL_SECONDS=3.0
MAX_POLL_TIMEOUT_SECONDS=600

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
